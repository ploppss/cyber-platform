[sub_resource type="GDScript" id="GDScript_toylo"]
script/source = "extends CharacterBody2D
## Movimiento básico de plataformas: izquierda/derecha + salto.
## No implementa ataques, dash, doble salto, agacharse ni habilidades especiales
## (eso queda fuera de la Fase 1 según el diseño).

@export var speed: float = 140.0
@export var jump_velocity: float = -260.0
@export var acceleration: float = 900.0
@export var friction: float = 900.0

var gravity: float = ProjectSettings.get_setting(\"physics/2d/default_gravity\")

@onready var status_effect_manager: StatusEffectManager = $StatusEffectManager
@onready var animated_sprite: AnimatedSprite2D = $AnimatedSprite2D

func _ready() -> void:
	# Spawnea mirando hacia la derecha
	# (Si tus dibujos base miran a la izquierda, true lo refleja hacia la derecha)
	animated_sprite.flip_h = true

func _physics_process(delta: float) -> void:
	# Gravedad
	if not is_on_floor():
		velocity.y += gravity * delta

	# Salto
	if Input.is_action_just_pressed(\"jump\") and is_on_floor():
		velocity.y = jump_velocity

	# Input horizontal, con soporte para que un futuro BackdoorEffect
	# invierta la dirección sin tocar esta lógica.
	var input_dir := Input.get_axis(\"move_left\", \"move_right\")

	if status_effect_manager.has_effect(\"inverted_controls\"):
		input_dir = -input_dir

	if input_dir != 0.0:
		velocity.x = move_toward(velocity.x, input_dir * speed, acceleration * delta)
	else:
		velocity.x = move_toward(velocity.x, 0.0, friction * delta)

	move_and_slide()
"

